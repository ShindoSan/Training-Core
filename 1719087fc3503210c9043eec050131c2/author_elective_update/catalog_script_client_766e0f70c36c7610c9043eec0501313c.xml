        <name>Check Max Training Entry onChange</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }
       var vacancies_left = g_form.getValue("vacancies_left");
    if (vacancies_left == 0 || vacancies_left == '0') {
        g_form.setValue("has_conflict", true);
        g_form.showFieldMsg('training_schedule', 'Please select a different session.', 'error');
		g_form.showFieldMsg('vacancies_left', 'Please select a different session.', 'error');
        g_form.addErrorMessage("This training session does not have vacancies left.");
    } else {
        g_form.setValue("has_conflict", false);
        g_form.clearMessages();
        g_form.hideFieldMsg('vacancies_left');
    }

   //Type appropriate comment here, and begin script below
   
}]]></script>
