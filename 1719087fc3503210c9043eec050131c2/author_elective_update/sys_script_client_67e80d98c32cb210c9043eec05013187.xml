        <messages/>
        <name>Validate Training Date</name>
        <order/>
        <script><![CDATA[function onLoad() {
  function onLoad() {
    var trainingDate = g_form.getValue('training_date');
    
    // Se o campo de data estiver vazio, não há nada para validar
    if (trainingDate === '') {
        return;
    }

    // Cria a chamada GlideAjax para o Script Include
    var ga = new GlideAjax('TrainingScheduleUtils');
    
    // Define o método a ser chamado no Script Include
    ga.addParam('sysparm_name', 'checkTrainingDate');
    
    // Passa a data do campo para o servidor
    ga.addParam('sysparm_training_date', trainingDate);
    
    // Envia a requisição de forma assíncrona
    ga.getXML(ajaxResponse);
    
    // Função que será executada quando a resposta do servidor chegar
    function ajaxResponse(response) {
        var answer = response.responseXML.documentElement.getAttribute("answer");

        if (answer === 'date_invalid') {
            g_form.showFieldMsg('training_date', 'The course date cannot be in the past, today, or tomorrow. Please select a future date.', 'error');
        }
    }
}
}]]></script>
