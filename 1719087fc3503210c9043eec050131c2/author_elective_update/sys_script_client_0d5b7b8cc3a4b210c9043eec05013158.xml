        <messages/>
        <name>Validate Duplicate Date</name>
        <order/>
        <script><![CDATA[function onSubmit() {
   
    var dataAgendamento = g_form.getValue('training_date');

   
    if (dataAgendamento == '') {
        return;
    }

 
    var registroAtualId = g_form.getUniqueValue();


    var ga = new GlideAjax('TrainingScheduleUtils');
   
    ga.addParam('sysparm_name', 'verificarDataDuplicada');
 
    ga.addParam('sysparm_data', dataAgendamento);
    ga.addParam('sysparm_registro_atual_id', registroAtualId);


    ga.getXMLWait();

    var resposta = ga.getAnswer();


    if (resposta == 'true') {
       
        g_form.addErrorMessage('Já existe um treinamento agendado para esta data. Por favor, escolha outro dia.');
        
        return false;
    }
}]]></script>
