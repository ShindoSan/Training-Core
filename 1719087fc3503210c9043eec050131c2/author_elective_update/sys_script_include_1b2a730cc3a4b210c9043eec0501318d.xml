        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var TrainingScheduleUtils = Class.create();
TrainingScheduleUtils.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
    checkDuplicateSchedule: function() {
        var training = this.getParameter('sysparm_training');
        var startDate = this.getParameter('sysparm_start_date');
        var grSchedule = new GlideRecord("x_1092529_traini_0_training_schedule");
        grSchedule.addEncodedQuery("training=" + training + "^training_dateON" + startDate + "@javascript:gs.dateGenerate('" + startDate + "','start')@javascript:gs.dateGenerate('" + startDate + "','end')");
        grSchedule.setLimit(1);
        grSchedule.query();

        if (grSchedule.next()) {
            return true;
        } else {
            return false;
        }

    },



    buscaMembrosDoGrupo: function(grupoId) {
        var membersArray = [];
        var grGroupMember = new GlideRecord("sys_user_grmember");
        grGroupMember.addQuery("group", grupoId);
        grGroupMember.query();
        while (grGroupMember.next()) {
            membersArray.push(grGroupMember.getValue('user'));
        }

        return 'sys_idIN' + membersArray.toString();

    },

checkTrainingDate: function() {
    var trainingDateStr = this.getParameter('sysparm_start_date');

    var gDate = new GlideDate();
    gDate.setValue(trainingDateStr);

    var today = new GlideDate();
    today.addDays(2);

    if (gDate.before(today)) {
        return 'date_invalid';
    }
	return 'date_valid';
},


    type: 'TrainingScheduleUtils'
});]]></script>
