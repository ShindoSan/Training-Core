        <condition/>
        <description/>
        <field>training_date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Validate Training  Duplicity and Data</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    g_form.hideFieldMsg("training_date");
    g_form.clearMessages();

    var trainingSysId = g_form.getValue("training");
    if (trainingSysId === '') {
        return;
    }

    var ga = new GlideAjax("TrainingScheduleUtils");
    ga.addParam("sysparm_name", "checkDuplicate");
    ga.addParam("sysparm_training", trainingSysId);
    ga.addParam("sysparm_start_date", newValue);

    ga.getXML(processAnswer);

    function processAnswer(response) {
        var answer = response.responseXML.documentElement.getAttribute("answer");

        if (answer === "date_invalid") {
            g_form.clearValue("training_date");
            g_form.showFieldMsg("training_date", "Please select a future date.", "error");
        } else if (answer === "true") {
            g_form.clearValue("training_date");
            g_form.showFieldMsg("training_date", "A duplicate training course already exists on this date. Please select a different date.", "error");
        }
    }
}]]></script>
