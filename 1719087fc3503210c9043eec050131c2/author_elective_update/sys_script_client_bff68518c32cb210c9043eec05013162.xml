        <messages/>
        <name>Validate Training  Duplicity</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var trainingDate = g_form.getValue('training_date');
    var trainingName = g_form.getValue('training');

    var ga = new GlideAjax('TrainingScheduleUtils');
    ga.addParam('sysparm_name', 'checkDuplicate');
    ga.addParam('sysparm_training_date', trainingDate);
    ga.addParam('sysparm_training', trainingName);
    ga.addParam('sysparm_current_sys_id', g_form.getUniqueValue());
    
    ga.getXMLWait();
    
    var answer = ga.getAnswer();

    if (answer === 'duplicate') {
        g_form.showFieldMsg('training_date', "There's already a course with the same name scheduled for this date. Please choose another date.", 'error');
        return false;
    }

    return true;
}]]></script>
