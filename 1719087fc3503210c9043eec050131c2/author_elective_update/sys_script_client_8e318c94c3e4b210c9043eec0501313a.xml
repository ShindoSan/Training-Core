        <messages/>
        <name>Validate Training Date</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    var ga = new GlideAjax('TrainingScheduleUtils');

    ga.addParam('sysparm_name', 'checkTrainingDate');
    
    ga.addParam('sysparm_training_date', newValue);
    
    ga.getXML(ajaxResponse);
    
    function ajaxResponse(response) {
        var answer = response.responseXML.documentElement.getAttribute("answer");

        if (answer === 'date_invalid') {
            g_form.setValue('training_date', '');
            g_form.showFieldMsg('training_date', 'The course date cannot be in the past, today, or tomorrow. Please select a future date.', 'error');
        }
    }
}
]]></script>
